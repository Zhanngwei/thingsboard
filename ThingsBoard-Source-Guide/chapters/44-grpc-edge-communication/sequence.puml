skinparam GroupBorderColor #176B87
skinparam GroupBackgroundColor #F8FAFC

participant "Edge caller" as Caller
participant "EdgeGrpcClient" as Client
participant "Netty ManagedChannel" as Channel
participant "Generated async stub" as Stub
participant "EdgeGrpcService" as Service
participant "EdgeGrpcSession" as Session
database "EdgeService / PostgreSQL" as DB

Caller -> Client: connect(routingKey, secret, callbacks)
Client -> Channel: NettyChannelBuilder.forAddress(host, port)
Client -> Channel: maxInboundMessageSize + keepalive + TLS/plaintext
Client -> Channel: build()
Client -> Stub: EdgeRpcServiceGrpc.newStub(channel)
Client -> Stub: withCompression("gzip").handleMsgs(outputObserver)
Stub -> Service: handleMsgs(StreamObserver<ResponseMsg>)
Service -> Session: new EdgeGrpcSession(...)
Session --> Stub: StreamObserver<RequestMsg>
Stub --> Client: inputStream

note over Client,Session
ManagedChannel and stream construction are transport setup.
Business authentication is not complete yet.
end note

Client -> Session: RequestMsg(CONNECT, routingKey, secret, EdgeVersion.V_3_6_4, clientMaxSize)
Session -> DB: findEdgeByRoutingKey(SYS_TENANT_ID, routingKey)
DB --> Session: Optional<Edge>
alt edge found and secret matches
    Session -> Service: sessionOpenListener(edgeId, session)
    Service -> Service: sessions.put(edgeId, session)
    Session -> DB: save server attribute edgeVersion (future ignored)
    Session --> Client: ConnectResponse(ACCEPTED, configuration, serverMaxSize)
    Session -> Session: connected = true
    Client -> Caller: onEdgeUpdate(configuration)
else bad credentials
    Session --> Client: ConnectResponse(BAD_CREDENTIALS)
    Session --> Client: outputStream.onError(...)
    Client -> Client: disconnect(true)
    Client -> Caller: onError(EdgeConnectionException)
else server processing error
    Session --> Client: ConnectResponse(SERVER_UNAVAILABLE)
end
@enduml

@startuml
title 44.2 Edge Uplink processing and response

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #111827
skinparam ArrowColor #253746
skinparam ArrowThickness 1.5
skinparam ParticipantBorderColor #334155
skinparam ParticipantBackgroundColor #E8F3F6
skinparam ParticipantFontColor #111827
skinparam NoteBorderColor #9A5B13
skinparam NoteBackgroundColor #FFF3DF
skinparam NoteFontColor #111827

participant "Edge business" as Business
participant "EdgeGrpcClient" as Client
participant "EdgeGrpcSession" as Session
participant "RateLimitService" as Rate
participant "Edge processors" as Processors
database "DAO / PostgreSQL / Timescale / Cassandra" as DB
participant "GrpcCallbackExecutor" as Callback

Business -> Client: sendUplinkMsg(UplinkMsg)
Client -> Client: static uplinkMsgLock.lock()
Client -> Session: RequestMsg(type=UPLINK, uplinkMsg=msg)
Client -> Client: unlock()
Session -> Rate: check EDGE_UPLINK_MESSAGES
Session -> Rate: check per Edge limit
alt rate limit rejected
    Session --> Client: UplinkResponse(success=false, "Rate limit reached")
    Client -> Business: onUplinkResponse(response)
else accepted
    Session -> Processors: processUplinkMsg(msg)
    loop each repeated message collection
        Processors -> DB: service/DAO operation
        DB --> Processors: ListenableFuture<Void>
    end
    Processors --> Session: Futures.allAsList(result)
    alt all futures succeeded
        Session -> Callback: onSuccess
        Callback -> Session: sendResponseMessage(id, true, null)
        Session --> Client: UplinkResponse(success=true, id)
    else any future failed
        Session -> Callback: onFailure(root cause)
        Callback -> Session: sendResponseMessage(id, false, error)
        Session --> Client: UplinkResponse(success=false, id)
    end
    Client -> Business: onUplinkResponse.accept(response)
end

note over Processors,DB
Futures.allAsList aggregates completion only.
It is not a transaction spanning all processors.
end note
@enduml

@startuml
title 44.3 Incremental Cloud-to-Edge downlink

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #111827
