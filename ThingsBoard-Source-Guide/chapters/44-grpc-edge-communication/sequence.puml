skinparam ArrowThickness 1.5
skinparam ParticipantBorderColor #334155
skinparam ParticipantBackgroundColor #E8F3F6
skinparam ParticipantFontColor #111827
skinparam NoteBorderColor #9A5B13
skinparam NoteBackgroundColor #FFF3DF
skinparam NoteFontColor #111827

participant "EdgeController" as Controller
participant "Origin EdgeGrpcService" as Origin
queue "TB Core notification" as Queue
participant "Owner App/Tenant Actor" as Actor
participant "Owner EdgeGrpcService" as Owner
participant "EdgeGrpcSession" as Session
participant "EdgeSyncCursor" as Cursor
participant "EdgeEventFetcher" as Fetcher
database "Entity DAO" as DB
participant "Remote Edge" as Edge

Controller -> Origin: processSyncRequest(request, responseConsumer)
Origin -> Origin: localSyncEdgeRequests.put(requestId)
Origin -> Queue: ToEdgeSyncRequest
Queue -> Actor: EdgeSessionMsg
Actor -> Owner: onToEdgeSessionMsg
Owner -> Session: startSyncProcess(true)
Owner -> Queue: FromEdgeSyncResponse(success=true)
Queue --> Origin: processSyncResponse(requestId)
Origin --> Controller: DeferredResult HTTP 200

note over Controller,Session
HTTP 200 means the owner session accepted the sync request.
It does not mean all full-sync pages have reached the Edge.
end note

Session -> Session: syncCompleted=false
Session -> Session: interrupt normal downlink task
Session -> Cursor: new EdgeSyncCursor(edge, fullSync=true)
loop while cursor.hasNext()
    Session -> Cursor: getNext()
    Cursor --> Session: fetcher
    Session -> Fetcher: fetch page
    Fetcher -> DB: query current assigned entities
    DB --> Fetcher: page
    Fetcher --> Session: temporary EdgeEvents
    Session -> Edge: DownlinkMsg pack
    Edge --> Session: DownlinkResponse ACKs
    Session -> Session: callback -> doSync(cursor)
end
Session -> Edge: DownlinkMsg(SyncCompletedMsg)
alt Edge returns success ACK
    Edge --> Session: DownlinkResponse ACK
else no ACK after maximum attempts
    Session -> Session: stopCurrentSendDownlinkMsgsTask(false)
end
Session -> Session: syncCompleted=true
@enduml

@startuml
title 44.5 Downlink ACK, retry, size rejection and completion

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #111827
skinparam ArrowColor #253746
skinparam ArrowThickness 1.5
skinparam ParticipantBorderColor #334155
skinparam ParticipantBackgroundColor #E8F3F6
skinparam ParticipantFontColor #111827
skinparam NoteBorderColor #9A5B13
skinparam NoteBackgroundColor #FFF3DF
skinparam NoteFontColor #111827

participant "EdgeGrpcSession" as Session
collections "pendingMsgsMap" as Pending
participant "edge-send-scheduler" as Scheduler
participant "Remote Edge" as Edge
participant "NotificationRuleProcessor" as Notify
participant "SettableFuture<Boolean>" as Future

Session -> Future: create()
Session -> Pending: clear(); put all messages
Session -> Scheduler: submit(attempt=1)
loop attempt 1..10 while pending
    Scheduler -> Pending: copy values
    alt serialized size exceeds client maximum
        Scheduler -> Notify: EdgeCommunicationFailureTrigger
        Scheduler -> Pending: remove(messageId)
    else size allowed
        Scheduler -> Edge: ResponseMsg.downlinkMsg
        alt success ACK
            Edge --> Session: DownlinkResponse(success=true, id)
            Session -> Pending: remove(id)
        else negative ACK or ACK missing
            Edge --> Session: failure response or no response
            Session -> Pending: keep id
        end
    end
    alt pending empty
        Session -> Future: set(false)
        Session -> Scheduler: cancel scheduled task
    else attempt < 10
        Scheduler -> Scheduler: schedule next after sleep_between_batches
    else attempt = 10
        Scheduler -> Notify: delivery failure notification
        Scheduler -> Future: set(false)
    end
end

note over Pending,Future
Future completion can mean "task stopped" after discarding messages.
It must not be interpreted as universal remote success.
end note
@enduml

@startuml
title 44.6 Disconnect, stale callback and reconnect

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #111827
skinparam ArrowColor #253746
skinparam ArrowThickness 1.5
skinparam ParticipantBorderColor #334155
skinparam ParticipantBackgroundColor #E8F3F6
skinparam ParticipantFontColor #111827
skinparam NoteBorderColor #9A5B13
skinparam NoteBackgroundColor #FFF3DF
skinparam NoteFontColor #111827

participant "Old Edge stream" as Old
participant "Old EdgeGrpcSession" as OldSession
collections "EdgeGrpcService.sessions" as Sessions
participant "New Edge stream" as New
participant "New EdgeGrpcSession" as NewSession
database "edge_event + cursor" as Durable

Old -> OldSession: transport onError/onCompleted
OldSession -> OldSession: connected=false
OldSession -> Sessions: onEdgeDisconnect(edge, oldSessionId)

New -> NewSession: CONNECT accepted
NewSession -> Sessions: onEdgeConnect(edgeId, newSession)
Sessions -> Sessions: put(edgeId, newSession)

OldSession -> Sessions: late close callback(oldSessionId)
Sessions -> Sessions: get(edgeId).sessionId == oldSessionId?
alt current id differs
    Sessions --> OldSession: stale; do not remove new session
else current id matches
    Sessions -> Sessions: remove(edgeId)
end

NewSession -> Durable: read persisted cursor
Durable --> NewSession: resume point
NewSession -> Durable: re-read uncommitted events

note over NewSession,Durable
In-memory pending messages are not restored.
Recovery is database cursor based and may replay messages.
end note
@enduml

