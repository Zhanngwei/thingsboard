title Cassandra - Dispatcher, Driver, Timeout and Callback Pools

participant "DAO caller" as Dao
queue "bounded task deque" as Buffer
participant "nosql-Write-dispatcher" as Dispatcher
participant "DataStax driver Future" as Driver
participant "nosql-Write-timeout" as Timeout
participant "nosql-Write-callback" as Callback
participant "caller Future" as CallerFuture
database Cassandra

Dao -> Buffer: submit(task)
alt tenant rate limited or queue full
  Buffer -> CallerFuture: setException immediately
  CallerFuture --> Dao: failed Future
else accepted
  Buffer --> Dao: pending wrapped Future
  Dispatcher -> Buffer: take task
  Dispatcher -> Dispatcher: remaining = createTime + maxWait - now
  alt expired before execution
    Dispatcher -> CallerFuture: setException(TimeoutException)
  else launch
    Dispatcher -> Driver: execute(task)
    Driver -> Cassandra: async statement
    Timeout -> Driver: withTimeout deadline
    alt driver result
      Cassandra --> Driver: result or failure
      Driver -> Callback: FutureCallback
      Callback -> CallerFuture: set / setException
    else timeout wins
      Timeout -> Callback: failure callback
      Callback -> CallerFuture: setException(TimeoutException)
    end
  end
end

group synchronous installation failure gap
  Dispatcher -> Dispatcher: execute / withTimeout / addCallback throws
  Dispatcher -> Dispatcher: outer catch updates stats and in-flight
  note right of CallerFuture
  The source path does not setException on taskCtx.future here.
  The caller Future may remain pending.
  end note
end

@enduml

